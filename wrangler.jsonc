{
  // BK Agro — Cloudflare Worker (website + order emails)
  "name": "bkagro",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Orders are emailed through Cloudflare Email Routing.
  // ORDER_TO must be a VERIFIED destination address in Email Routing.
  "send_email": [
    { "name": "ORDER_EMAIL" }
  ],
  "vars": {
    "ORDER_TO": "bkagro2025@gmail.com",
    "ORDER_FROM": "orders@bkagrobd.com"
  }
}
